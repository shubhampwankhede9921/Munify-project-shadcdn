# API Configuration
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Perdix API Configuration
# Organization Types Root Branch ID (default: 999)
VITE_PERDIX_ORG_TYPES_BRANCH_ID=999

# Municipalities Root Branch ID (default: 101)
VITE_PERDIX_MUNICIPALITIES_BRANCH_ID=101

# Perdix Query Identifier (default: childBranch.list)
VITE_PERDIX_CHILD_BRANCH_IDENTIFIER=childBranch.list

# Skip Relogin Flag (default: yes)
VITE_PERDIX_SKIP_RELOGIN=yes

# Default Query Limit (0 = no limit, default: 0)
VITE_PERDIX_DEFAULT_LIMIT=0

# Default Query Offset (default: 0)
VITE_PERDIX_DEFAULT_OFFSET=0

# Perdix JWT Token (if needed for direct Perdix API calls)
# VITE_PERDIX_JWT=your_jwt_token_here
